# Caddy configuration para Workout Tracker
# 
# Opção 1: Proxy reverso para dev server (npm run dev)
# Use quando quiser testar com o servidor Node rodando
localhost:3000 {
	reverse_proxy localhost:3001
	encode gzip
	log {
		output stdout
		level INFO
	}
}

# Opção 2: Arquivos estáticos (após npm run generate)
# Descomente e comente a Opção 1 quando quiser servir o build estático
#
# localhost:8080 {
# 	root * .output/public
# 	file_server
# 	try_files {path} /index.html
# 	encode gzip
# }
